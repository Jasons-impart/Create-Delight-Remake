# Default: ignore everything at the repo root.
/*

# Root files we intentionally version.
!/.gitignore
!/.gitmodules
!/.hmclversion.cfg
!/.options.txt
!/.packwizignore
!/GettingStarted.md
!/LICENSE
!/README.md
!/index.html
!/client_jvm_args.example.txt
!/icon.png
!/server-icon.png
!/modpack.toml
!/start.bat
!/start.sh
!/sync-packwiz-assets.bat
!/update-packwiz-meta.bat
!/variables.txt
!/variables.nix.txt

# Root directories that manage their own allowlists.
!/.agents/
!/.zcode/
!/.codex/
!/.github/
!/PCL/
!/config/
!/CDC-mod-src/
!/defaultconfigs/
!/docs/
!/hotai/
!/kubejs/
!/ldlib/
!/minemenu/
!/mods/
!/packwiz-files/
!/resourcepacks/
!/schematics/
!/scripts/
!/shaderpacks/
!/tacz/
/tacz/*.zip

# Agent knowledge base (compatible with OpenCode + Codex)
!/AGENTS.md
!/lessons-learned.md

# Python runtime artifacts (e.g. scripts/__pycache__/)
__pycache__/
*.py[cod]
