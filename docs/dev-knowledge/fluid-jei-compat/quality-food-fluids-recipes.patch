diff --git a/src/main/java/io/github/createdelight/qualityfoodfluids/mixin/CgtJeiDrinkRecipesMixin.java b/src/main/java/io/github/createdelight/qualityfoodfluids/mixin/CgtJeiDrinkRecipesMixin.java
