diff --git a/src/gameTest/java/io/github/createdelight/qualityfoodfluids/compat/jei/CgtJeiRecipeTests.java b/src/gameTest/java/io/github/createdelight/qualityfoodfluids/compat/jei/CgtJeiRecipeTests.java
