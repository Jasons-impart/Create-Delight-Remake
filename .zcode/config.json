{
  "hooks": {
    "enabled": true,
    "events": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": [
                "${CLAUDE_PROJECT_DIR}/scripts/run-knowledge-hook.py",
                "validate-knowledge-base.ps1"
              ],
              "timeoutMs": 30000
            },
            {
              "type": "process",
              "command": "python",
              "args": [
                "${CLAUDE_PROJECT_DIR}/scripts/run-knowledge-hook.py",
                "write-knowledge-candidate-report.ps1"
              ],
              "timeoutMs": 30000
            }
          ]
        }
      ]
    }
  }
}
